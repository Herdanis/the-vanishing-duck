# secrets.local — custom secret values for the-vanishing-duck
# Copy to: ~/.config/the-vanishing-duck/secrets.local
#
# Literal values — redacted everywhere they appear in tool output or chat.
# One value per line. Lines starting with # are comments.
#
# Examples:
#   my_database_password
#   internal-api-key-12345
#   company_secret_token_abc
#
# Regex patterns — custom format detection.
# Format: regex: <pattern> as <LABEL>
#
# Examples:
#   regex: \bcompany_[a-z0-9]{20}\b as COMPANY_TOKEN
#   regex: \bint_[a-z0-9]{16}\b as INTERNAL_ID
